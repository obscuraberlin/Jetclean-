{
  "name": "jetclean-website",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing-Website und Lead-Funnel der JETCLEAN Gebäudeservice GmbH (Berlin)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
