# ---------------------------------------------------------------------------
# JETCLEAN Website – Environment Variables
# Kopiere diese Datei nach `.env.local` und trage die echten Werte ein.
# Niemals echte Secrets in dieses Beispiel oder ins Repository committen.
# ---------------------------------------------------------------------------

# Öffentliche Basis-URL der Website (ohne Slash am Ende). Wird für Canonical-URLs,
# Sitemap, OpenGraph und die robots.txt verwendet.
# Produktion z. B. https://www.jetclean-berlin.de
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Projekt (Settings -> API). URL und anon key sind öffentlich,
# der Service-Role-Key ist geheim und wird ausschließlich serverseitig verwendet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-Mail-Benachrichtigung bei neuen Anfragen (optional, Adapter: Resend).
# Bleiben die Werte leer, wird keine E-Mail versendet – der Lead landet trotzdem in der DB.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
LEAD_FROM_EMAIL=

# Spam-Schutz: maximale Formular-Anfragen je IP innerhalb von 10 Minuten (Standard 5).
LEAD_RATE_LIMIT_MAX=

# Cookiefreie Analytics über Plausible (optional). Leer lassen = kein Tracking-Script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
